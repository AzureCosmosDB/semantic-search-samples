# Documentation template only. Export in your shell; no automatic dotenv loading.
COSMOS_DB_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_DB_DATABASE=<existing-database>
COSMOS_DB_CONTAINER_QFLAT=reranker_dotnet_qflat
COSMOS_DB_CONTAINER_DISKANN=reranker_dotnet_diskann
INFERENCE_ENDPOINT=https://<account>.<region>.dbinference.azure.com
RERANKER_MODEL=aisearch-reranker
# Default is Direct. Gateway is optional for networks that block direct TCP.
COSMOS_CONNECTION_MODE=Direct

# Optional. Needed only for vector/hybrid UI queries.
AZURE_OPENAI_ENDPOINT=https://<openai-account>.openai.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<1536-dimension-embedding-deployment>
AZURE_OPENAI_API_VERSION=2024-02-01
# Prefer DefaultAzureCredential. If set, this optional key replaces Entra for OpenAI only.
# AZURE_OPENAI_API_KEY=

# Optional for a user-assigned managed identity.
# AZURE_CLIENT_ID=<managed-identity-client-id>
# RUN_LIVE_TESTS=1
