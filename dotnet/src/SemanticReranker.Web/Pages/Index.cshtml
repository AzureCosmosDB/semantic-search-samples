@page
@model IndexModel
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Azure Cosmos DB - Semantic Search Demo</title>
  <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
  <script src="~/advanced-reranking.js" asp-append-version="true" defer></script>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to results</a>
<div class="search-layout">
    <aside class="search-sidebar" aria-labelledby="search-heading">
      <h2 id="search-heading">Search settings</h2>
      <form method="post" id="search-form">
        <label asp-for="Container">Index</label>
        <select asp-for="Container">
          <option value="qflat" data-container-name="@Model.QflatContainer">QFLAT &amp; Full Text Search Index</option>
          <option value="diskann" data-container-name="@Model.DiskannContainer">DiskANN &amp; Full Text Search Index</option>
        </select>
        <label asp-for="Query">Search input</label>
        <input asp-for="Query" type="text" maxlength="1000" placeholder="Woody Buzz" required aria-describedby="search-input-help" />
        <p class="help-text" id="search-input-help">Enter a phrase or keywords, then choose a search below.</p>
        <label class="checkbox"><input asp-for="Rerank" /> Use Semantic Reranker</label>
        <details id="advanced-reranking" open="@(Model.ErrorMessage is not null && Model.Rerank)">
          <summary>Advanced reranking</summary>
          <p class="help-text">Applied only when Use Semantic Reranker is selected.</p>
          <fieldset id="rerank-options">
            <legend class="visually-hidden">Reranker options</legend>
            <label asp-for="DocumentFormat">Document format</label>
            <select asp-for="DocumentFormat">
              <option value="text">text</option>
              <option value="json">json</option>
            </select>
            <label asp-for="TargetPaths">JSON fields</label>
            <select asp-for="TargetPaths" aria-describedby="json-fields-help">
              <option value="title,text">Title and Description</option>
              <option value="title">Title only</option>
              <option value="text">Description only</option>
            </select>
            <p class="help-text" id="json-fields-help">For json only. Description maps to the text field. Only selected JSON fields are sent.</p>
            <label asp-for="RerankTopK">Rerank result limit</label>
            <input asp-for="RerankTopK" type="number" min="1" max="10" step="1" required />
            <label class="checkbox"><input asp-for="ReturnSentenceScores" /> Sentence-score diagnostics</label>
            <p class="help-text">Service sentence indices are not mapped to source text or JSON fields.</p>
          </fieldset>
        </details>
        <div class="search-actions" role="group" aria-label="Ranked search">
          <button type="submit" name="Mode" value="Vector">Similarity search</button>
          <button type="submit" name="Mode" value="FullTextRank">Full text ranking</button>
          <button type="submit" name="Mode" value="Hybrid">Hybrid search</button>
        </div>
        <fieldset class="search-type" aria-describedby="search-type-help">
          <legend>Search type</legend>
          <label class="radio"><input asp-for="AllKeywords" type="radio" id="AllKeywords" value="true" /> all keywords</label>
          <label class="radio"><input asp-for="AllKeywords" type="radio" id="AnyKeywords" value="false" /> any keywords</label>
          <p class="help-text" id="search-type-help">Applies to Full text search only.</p>
        </fieldset>
        <button type="submit" name="Mode" value="FullText">Full text search</button>
      </form>
      <p class="sidebar-note">Similarity and hybrid search use an embedding deployment. Full text modes do not. Semantic reranking uses the separate Azure Data AI inference service.</p>
    </aside>
    <main id="main-content" tabindex="-1">
      <header class="page-header">
        <h1>Azure Cosmos DB - Semantic Search Demo</h1>
        <p>Explore vector search, full text search, text ranking, and hybrid search. Compare retrieval results with optional semantic reranking.</p>
      </header>
      <section id="dataset-summary" aria-labelledby="dataset-heading">
        <h2 id="dataset-heading">Default source corpus: MovieLens</h2>
        <p>4,489 source rows of movie metadata and plot overviews, including Toy Story and Grumpier Old Men.
          <a href="https://github.com/TheovanKraay/AzureDataRetrievalAugmentedGenerationSamples/blob/7fd162fc633617857f8b8ed2c5b2b92d4d8ef0b6/DataSet/Movies/MovieLens-4489-256D.json">View pinned MovieLens source</a></p>
        <p>Default <code>azd up</code> restores every source row with fresh 1536-dimensional embeddings.
          With custom data, use searches suited to your documents.
          This describes the source corpus, not a live inventory of the selected container.</p>
        <p><strong>Example searches for MovieLens:</strong>
          Full text: <code>Woody Buzz</code> or <code>fishing buddies</code>.
          Similarity / hybrid: <code>toys learning to share a child's affection</code>.</p>
        <p class="dataset-config">Configured database: <span>@Model.ConfiguredDatabase</span>
          <span aria-hidden="true"> | </span> Selected container: <span id="selected-container">@Model.SelectedContainer</span></p>
        <noscript><p class="help-text">The selected container label updates when you submit a search.</p></noscript>
      </section>
      <section aria-label="Search results">
      @if (Model.ErrorMessage is not null)
      {
        <div id="search-error" role="alert">
          <h2>Search could not complete</h2>
          <p>@Model.ErrorMessage</p>
        </div>
      }
      @if (Model.Result is { } result)
      {
        <div class="results-heading">
          <h2 id="result-status">@(result.Reranked ? "Reranked results" : "Retrieval results")</h2>
          <span id="result-count">@result.Rows.Count results</span>
        </div>
        <p class="result-context">@(Model.Mode switch {
          SearchMode.Vector => "Similarity search",
          SearchMode.FullTextRank => "Full text ranking",
          SearchMode.Hybrid => "Hybrid search",
          _ => "Full text search"
        }) <span aria-hidden="true">&middot;</span> @Model.Query</p>
        <p id="candidate-count" class="help-text">Retrieved candidates: @result.RetrievedCount; returned results: @result.Rows.Count</p>
        <dl id="diagnostics">
          <div><dt>Retrieval</dt><dd>@result.RetrievalMilliseconds.ToString("F1") ms</dd></div>
          <div><dt>Embedding</dt><dd>@result.EmbeddingMilliseconds.ToString("F1") ms</dd></div>
          <div><dt>Reranking</dt><dd>@result.RerankMilliseconds.ToString("F1") ms</dd></div>
          <div><dt>Total</dt><dd>@result.TotalMilliseconds.ToString("F1") ms</dd></div>
          <div><dt>Cosmos request charge (all pages)</dt><dd>@result.RequestCharge.ToString("F2") RU</dd></div>
        </dl>
        @if (result.Rows.Count == 0)
        {
          <div class="empty-state">
            <h3>No matching documents</h3>
            <p>Try fewer keywords, select any keywords for Full text search, or choose another search. Reranking was not invoked.</p>
          </div>
        }
        else
        {
          <div class="table-scroll" role="region" aria-label="Results table" tabindex="0">
          <table id="results">
            <caption class="visually-hidden">Retrieved documents with original retrieval ranks and available scores</caption>
            <thead><tr><th scope="col">Rank</th><th scope="col">Title / ID</th><th scope="col">Description</th><th scope="col">Vector distance</th><th scope="col">Rerank score</th></tr></thead>
            <tbody>
            @for (var index = 0; index < result.Rows.Count; index++)
            {
              var row = result.Rows[index];
              <tr>
                <td class="rank-cell"><strong>@(index + 1)</strong><span class="secondary">Retrieval rank: @row.RetrievalRank</span></td>
                <td class="title-cell"><strong>@row.Title</strong><span class="secondary document-id">ID: @row.Id</span></td>
                <td class="description-cell">@row.Text</td>
                <td class="numeric">@(row.RetrievalScore?.ToString("F5") ?? "n/a")</td>
                <td class="rerank-score">@(row.RerankScore?.ToString("F5") ?? "n/a")</td>
              </tr>
            }
            </tbody>
          </table>
          </div>
          @if (result.SentenceScoresRequested)
          {
            for (var index = 0; index < result.Rows.Count; index++)
            {
              var row = result.Rows[index];
              <details class="sentence-scores">
                <summary>Sentence scores: result @(index + 1) (@row.Id)</summary>
                @if (row.SentenceScores is { Count: > 0 } sentences)
                {
                  foreach (var sentence in sentences)
                  {
                    <p>Service sentence index: @sentence.Index; score: @sentence.Score</p>
                  }
                }
                else
                {
                  <p>Sentence scores: not returned.</p>
                }
              </details>
            }
          }
        }
        <p class="help-text score-help">Vector distance is lower-is-better. Rerank score is higher-is-better. Full-text and RRF scores are not projected by this query.</p>
        <details class="query-details"><summary>Executed query (embedding parameter omitted)</summary><pre>@result.Sql</pre></details>
      }
      else if (Model.ErrorMessage is null)
      {
        <div class="empty-state initial-state">
          <h2>Choose a search to get started</h2>
          <p>Enter a phrase or keywords in Search input, choose an index, and select a search button.</p>
          <p>Start with <strong>SPECTRE spy</strong> for the sample movies. Enable Use Semantic Reranker to compare semantic relevance after retrieval.</p>
        </div>
      }
      </section>
    </main>
</div>
</body>
</html>
